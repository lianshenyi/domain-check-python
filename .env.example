TG_BOT_TOKEN=your-bot-token
TG_CHAT_ID=your-chat-id

# 异常通知冷却时间，单位：小时；修改后重启服务
ALERT_COOLDOWN_HOURS=3

# 公共 DNS 交叉判定：逗号分隔的公共递归 DNS。
# 查不到 A 记录时直接判失败；DNS 自身不可达时降级为仅按 HTTP 判定。
# 留空表示关闭公共 DNS 判定，退回纯 HTTP 行为。
PUBLIC_RESOLVERS=8.8.8.8,1.1.1.1

# 发送“恢复通知”前需要连续成功的轮数，必须 >= 1
RECOVERY_CONFIRM_ROUNDS=3

# 单次公共 DNS 查询超时，单位：秒
PUBLIC_DNS_TIMEOUT=3.0
